   <td balign="left">USB A</td>
   <td balign="left">4-pin</td>
  </tr></table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1">
   <tr>
    <td port="p1l">1</td>
    <td>VBUS</td>
   </tr>
   <tr>
    <td port="p2l">2</td>
    <td>D-</td>
   </tr>
   <tr>
    <td port="p3l">3</td>
    <td>D+</td>
   </tr>
   <tr>
    <td port="p4l">4</td>
